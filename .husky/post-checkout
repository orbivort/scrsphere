#!/usr/bin/env sh
set -e

# post-checkout hook - validates branch names after checkout
# Args: $1 = previous HEAD ref, $2 = new HEAD ref, $3 = branch checkout flag (1=branch, 0=file)

# Only validate on branch checkout (not file checkout)
if [ "$3" = "1" ]; then
  echo "🌿 Validating git branch name..."
  node scripts/utility/validate-git-branch.js --quiet
fi