# =============================================================================
# Scrumooth Backend - Development Dockerfile
# =============================================================================
# Optimized for development with hot reload and debugging support
# Following Docker and OCI best practices
# =============================================================================

# Build arguments for version pinning
ARG NODE_VERSION=24.14.1
ARG PNPM_VERSION=11.5.0

FROM debian:bookworm-slim

# Build arguments for labels
ARG VERSION
ARG BUILD_DATE
ARG VCS_REF
ARG NODE_VERSION
ARG PNPM_VERSION

# OCI Image Labels
LABEL org.opencontainers.image.title="Scrumooth Backend Development" \
      org.opencontainers.image.description="Development environment for Scrumooth Backend API" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="Scrumooth" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/orbivort/scrumooth"

WORKDIR /app

# Install build dependencies and Node.js
RUN apt-get update && apt-get install -y --no-install-recommends \
    dumb-init \
    git \
    curl \
    ca-certificates \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Download and install Node.js from official binaries
ARG NODE_VERSION
RUN curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz -o /tmp/node.tar.xz && \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 && \
    rm -f /tmp/node.tar.xz && \
    ls -la /usr/local/bin/node && \
    /usr/local/bin/node --version && \
    /usr/local/bin/npm --version

# Add Node.js to PATH
ENV PATH="/usr/local/bin:${PATH}" \
    CI=true

# Install pnpm using corepack
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Security: Create non-root user and group with fixed IDs
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs --home-dir /home/scrumooth --create-home scrumooth

# Copy package files first for better layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages/shared/package.json packages/shared/tsconfig.json ./packages/shared/
COPY packages/backend/package.json packages/backend/tsconfig.json ./packages/backend/

# Extract app version from package.json (avoids hardcoding)
RUN node -e "console.log(require('./packages/backend/package.json').version)" > /tmp/app_version

# Install dependencies
RUN pnpm install --shamefully-hoist

# Copy source code
COPY packages/shared ./packages/shared
COPY packages/backend ./packages/backend

# Generate Prisma client
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"
RUN cd packages/backend && pnpm exec prisma generate --schema=prisma/schema.prisma

# Create required directories with proper permissions
RUN mkdir -p /app/logs && \
    chown -R scrumooth:nodejs /app

# Copy entrypoint script
COPY --chown=scrumooth:nodejs packages/backend/scripts/docker-entrypoint.dev.sh ./docker-entrypoint.sh
RUN chmod +x ./docker-entrypoint.sh

# Set development environment
ENV NODE_ENV=development \
    PORT=5001 \
    CI=true

# Switch to non-root user
USER scrumooth

# Expose application port
EXPOSE 5001

# Health check for development
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:5001/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})" || exit 1

# Use dumb-init as PID 1 for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Start development server with database migrations
CMD ["./docker-entrypoint.sh"]
