{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // Backend uses ESM syntax (tsx in dev, tsc for build) with path aliases and
    // extensionless relative imports, so moduleResolution "bundler" is required.
    // A move to "NodeNext" would require adding explicit .js extensions to all
    // relative imports and resolving path aliases at runtime.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@routes/*": ["./src/routes/*"],
      "@controllers/*": ["./src/controllers/*"],
      "@services/*": ["./src/services/*"],
      "@middleware/*": ["./src/middleware/*"],
      "@utils/*": ["./src/utils/*"],
      "@types/*": ["./src/types/*"],
      "@prisma": ["./prisma"],
      "@scrumooth/shared": ["../shared/dist"],
      "@e2e-helpers": ["./src/__tests__/e2e/helpers"]
    },
    "types": ["node"]
  },
  "references": [{ "path": "../shared" }],
  "include": ["src/**/*", "src/**/*.json"],
  "exclude": ["node_modules", "dist", "coverage", "vitest.config.ts"]
}
