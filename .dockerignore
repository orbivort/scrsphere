# =============================================================================
# Docker Ignore File for Scrumooth
# =============================================================================
# This file is derived from .gitignore with Docker-specific additions.
# Key principle: If it's not needed for the build, exclude it!
# Optimized for minimal build context and faster builds
# =============================================================================

# -----------------------------------------------------------------------------
# Version Control (Docker-specific: always exclude)
# -----------------------------------------------------------------------------
.git/
.gitignore
.gitattributes
.github/
.gitmodules
.svn/
.hg/
.hgignore
.bzr/

# -----------------------------------------------------------------------------
# Dependencies (must be installed fresh in container)
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.pnpm-debug.log*
.pnpm-store/
.pnpm-lock.yaml.bak

# -----------------------------------------------------------------------------
# Build Outputs (will be generated during build)
# -----------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
**/out/
*.tsbuildinfo
tsconfig.tsbuildinfo
.vite/
*.vite
.rollup.cache/
.next/
.nuxt/

# -----------------------------------------------------------------------------
# Environment Files (security critical - never include)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
packages/*/.env
packages/*/.env.*
!packages/*/.env.example
!k6/.env.k6.example

# -----------------------------------------------------------------------------
# IDE & Editor Files (not needed in builds)
# -----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
*.swp
*.swo
*~
.cursor/
.cursorrules
.codewhisperer/
.tabnine/
.codeium/
.trae/
.windsurf/
.codebuddy/
AGENTS.md
CLAUDE.md
CODEBUDDY.md
openspec/
*.copilot
*.sublime-project
*.sublime-workspace
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp

# -----------------------------------------------------------------------------
# OS Generated Files
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk
.nfs*

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Cache Directories (not needed for builds)
# -----------------------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.prettiercache
.npm/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.yarn-integrity
.pnp.*
.turbo
.webpack-cache/
.node_repl_history
.babel_cache/

# -----------------------------------------------------------------------------
# Testing & Coverage (not needed for production builds)
# -----------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
playwright-report/
**/playwright-report/
test-results/
**/test-results/
playwright/.cache/
**/playwright/.cache/
benchmark-results/
**/benchmark-results/
__tests__/
**/__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
cypress/videos/
**/cypress/videos/
cypress/screenshots/
**/cypress/screenshots/
cypress/downloads/
**/cypress/downloads/
.jest-cache/
# E2E test sources (Playwright) - not needed in production image builds
**/e2e/
e2e/
**/playwright/

# Load testing (k6) - not needed in production image builds
**/k6/
k6/

# Security / static analysis reports
.snyk/
.grype/
.trivy/
semgrep/
scan-results/
dependency-check-report.html

# -----------------------------------------------------------------------------
# Database Files (use containerized databases)
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db

# -----------------------------------------------------------------------------
# Prisma Generated (will be generated during build)
# -----------------------------------------------------------------------------
**/prisma/generated/
**/generated/prisma/

# -----------------------------------------------------------------------------
# Secrets & Certificates (security critical - never include)
# -----------------------------------------------------------------------------
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.p7b
*.p7c
secrets/
.secrets/
certs/

# -----------------------------------------------------------------------------
# Documentation (not needed in images)
# -----------------------------------------------------------------------------
docs/
**/docs/
*.md
**/*.md
!README.md
LICENSE

# -----------------------------------------------------------------------------
# Docker Files (prevent recursive builds)
# -----------------------------------------------------------------------------
Dockerfile*
docker-compose*.yml
.docker/
.dockerignore
.docker-compose/

# -----------------------------------------------------------------------------
# CI/CD (not needed in images)
# -----------------------------------------------------------------------------
.azure-pipelines/
.bitbucket-pipelines/
.circleci/
.travis.yml
Jenkinsfile
.gitlab-ci.yml

# -----------------------------------------------------------------------------
# Misc Build Artifacts
# -----------------------------------------------------------------------------
tmp/
**/tmp/
temp/
**/temp/
*.tmp
*.temp
backup/
**/backup/
backups/
**/backups/
*.bak
*.backup
.netlify
.vercel
storybook-static/

# -----------------------------------------------------------------------------
# Kubernetes & Infrastructure (not needed in images)
# -----------------------------------------------------------------------------
k8s/
kubernetes/
helm/
.terraform/
*.tfstate
*.tfstate.*

# -----------------------------------------------------------------------------
# Scripts
# -----------------------------------------------------------------------------
scripts/
!scripts/utility/add-import-extensions.js
# NOTE: scripts/maintenance and scripts/deployment are intentionally excluded.
# The backup service builds from its own subdirectory context
# (scripts/maintenance/database), which has its own .dockerignore.
!scripts/deployment/*
# Allow backend scripts for configuration validation
!packages/backend/scripts/*

# -----------------------------------------------------------------------------
# Large Binary Files (should be downloaded or built)
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.iso
*.bin

# -----------------------------------------------------------------------------
# Package Manager Lock Files (keep pnpm-lock.yaml for reproducibility)
# -----------------------------------------------------------------------------
# Keep pnpm-lock.yaml
package-lock.json
yarn.lock

# -----------------------------------------------------------------------------
# TypeScript Project References (covered by *.tsbuildinfo above)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Catch-all: ignore all hidden dotfiles by default, then whitelist the ones
# the build actually needs. This mirrors Docker best practices and keeps the
# build context minimal regardless of what tools create dotfiles locally.
# -----------------------------------------------------------------------------
.*
!/.dockerignore
!/.env.example
!/.eslintrc*
!/.prettier*
!/.stylelintrc*
!/.nvmrc
!/.node-version
!/.npmrc
!/.pnpmfile.cjs
!/.editorconfig
